# ─────────────────────────── Final-Bankai ───────────────────────────
# Copy to .env and adjust. NEVER commit real secrets.

NODE_ENV=production
PORT=4000

# Platform database (users, sessions, audit, notifications, links)
DATA_DIR=./data
FINAL_DB=./data/final.db

# The three module databases — point these at the live files/volumes
ROSTER_DB=./data/roster.db
HIRING_DB=./data/hiring.db
TICKETING_DB=./data/ticketing.db

# Bootstrapped Super Admin (created only when the users table is empty)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Platform Owner

# Session lifetime (hours)
SESSION_TTL_HOURS=12

# Member systems (embedded through /sys/<key> — override if you self-host elsewhere)
ROSTER_URL=https://bankairosterattendancee-production.up.railway.app
HIRING_URL=https://bankai-hiring-production.up.railway.app
TICKETS_URL=https://das-ticketing-system-production.up.railway.app

# Live hub credentials (to listen for changes inside these systems)
ROSTER_PASSWORD=            # roster admin/supervisor password → long-poll its revision bus
DAS_ADMIN_PASS=             # ticketing admin password → diff tickets + advances
